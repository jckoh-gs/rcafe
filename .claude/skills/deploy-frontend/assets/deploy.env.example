# Copy to <frontend-dir>/.deploy/<env>.env (e.g. frontend/.deploy/prod.env).
# Contains no secrets and can be committed. Never put credentials here:
# every variable is exported to the build, and build-time vars end up in the public bundle.

# --- Deploy target (required) ---
S3_BUCKET=my-app-prod-web
CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC

# --- AWS (optional) ---
# AWS_PROFILE=my-app-prod
# AWS_REGION=ap-northeast-2
# Abort if the credentials resolve to a different account.
# AWS_ACCOUNT_ID=123456789012

# --- Build (optional) ---
# BUILD_COMMAND="npm run build"   # default: detected from the lockfile
# BUILD_DIR=dist                  # default: dist, then build
# HASHED_ASSETS_DIR=assets        # default: assets (Vite), then static (CRA)

# --- Build-time app config, per environment ---
VITE_API_BASE_URL=https://api.example.com
